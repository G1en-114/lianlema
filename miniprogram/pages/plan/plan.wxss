.hero {
  margin-top: 24rpx;
  padding: 40rpx 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-meta {
  color: var(--brand);
  font-size: 28rpx;
  font-weight: 600;
}

.week-strip {
  white-space: nowrap;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.day-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
  padding: 16rpx 0;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
}

.day-chip-today {
  border-color: var(--brand);
  background: var(--brand-weak);
}

.day-num {
  font-size: 28rpx;
  font-weight: 600;
}

.day-state {
  font-size: 22rpx;
  color: var(--ink-2);
}

.exercise-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.exercise-row:last-child {
  border-bottom: none;
}

.exercise-name {
  font-size: 32rpx;
  font-weight: 600;
}

.regression-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--warn);
}

.quota-tip {
  margin-top: 16rpx;
  text-align: center;
  color: var(--brand);
}
