.hero {
  margin-top: 24rpx;
  padding: 40rpx 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-meta {
  color: var(--brand);
  font-size: 28rpx;
  font-weight: 600;
}

.week-strip {
  white-space: nowrap;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.day-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
  padding: 16rpx 0;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
}

.day-chip-today {
  border-color: var(--brand);
  background: var(--brand-weak);
}

.day-num {
  font-size: 28rpx;
  font-weight: 600;
}

.day-state {
  font-size: 22rpx;
  color: var(--ink-2);
}

.exercise-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.exercise-row:last-child {
  border-bottom: none;
}

.exercise-name {
  font-size: 32rpx;
  font-weight: 600;
}

.regression-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--warn);
}

.quota-tip {
  margin-top: 16rpx;
  text-align: center;
  color: var(--brand);
}

/* ---- 每日打卡连胜卡（智能日常：习惯环） ---- */
.streak-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.streak-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 24rpx;
  border-right: 2rpx solid var(--line);
  min-width: 140rpx;
}

.streak-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.1;
}

.streak-label {
  font-size: 22rpx;
  color: var(--ink-2);
}

.streak-right {
  flex: 1;
}

.streak-title {
  font-size: 30rpx;
  font-weight: 600;
}

.streak-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
}

/* ---- 今日微训练推荐卡 ---- */
.pick-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pick-min {
  font-size: 24rpx;
  color: var(--brand);
  background: var(--brand-weak);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.pick-items {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pick-item {
  font-size: 24rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  color: var(--ink-2);
}

.pick-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.pick-btn {
  margin: 0;
}
