.page {
  padding-top: 0;
}

.camera-area {
  position: relative;
  height: 560rpx;
  background: #111827;
  overflow: hidden;
}

.camera {
  width: 100%;
  height: 100%;
}

.camera-demo {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #d1d5db;
}

.demo-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.demo-text {
  font-size: 30rpx;
  font-weight: 600;
}

.demo-sub {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 8rpx;
}

.pose-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.hud {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.hud-item {
  background: rgba(17, 24, 39, 0.72);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  text-align: center;
  color: #fff;
  min-width: 96rpx;
}

.hud-num {
  font-size: 32rpx;
  font-weight: 700;
}

.hud-label {
  font-size: 20rpx;
  opacity: 0.8;
}

.pause-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.6);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.rest-num {
  font-size: 88rpx;
  color: #4ade80;
}

.session-card {
  margin-top: 24rpx;
}

.session-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.regression-note {
  font-size: 24rpx;
  color: var(--warn);
  margin-bottom: 8rpx;
}

.coach-banner {
  background: var(--brand-weak);
  color: var(--brand);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin: 16rpx 0 8rpx;
}

.coach-banner-fix {
  background: #fff7ed;
  color: var(--warn);
}

.ctrl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.ctrl {
  flex: 1 1 40%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  font-size: 28rpx;
  background: var(--card);
}

.voice-row {
  margin-top: 24rpx;
  text-align: center;
}

.voice-btn {
  background: var(--brand);
  color: #fff;
  border-radius: 46rpx;
  font-size: 30rpx;
  line-height: 92rpx;
  height: 92rpx;
}

.voice-btn-rec {
  background: var(--danger);
}

.voice-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
}
