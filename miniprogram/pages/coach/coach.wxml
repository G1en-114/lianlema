<view class="page coach-page">
  <view wx:if="{{offline}}" class="card offline-tip">
    <view class="muted">未连接云端模型服务：当前为本地模板回复（演示）。连接方式见 README《启用模型服务》。</view>
  </view>

  <scroll-view class="msgs" scroll-y scroll-into-view="{{anchor}}" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="m{{item.id}}"
      class="bubble-row {{item.role === 'user' ? 'bubble-row-user' : ''}}"
    >
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : ''}}">
        <text user-select>{{item.content}}</text>
        <view wx:if="{{item.suggestions.length}}" class="sug">
          <view wx:for="{{item.suggestions}}" wx:for-item="s" wx:key="*this" class="sug-item">· {{s}}</view>
        </view>
        <view wx:if="{{item.sourceLabel}}" class="src">{{item.sourceLabel}}</view>
      </view>
    </view>
  </scroll-view>

  <view class="quick" wx:if="{{!thinking && messages.length <= 2}}">
    <view
      wx:for="{{quickPrompts}}"
      wx:key="*this"
      class="quick-chip"
      bindtap="onQuick"
      data-q="{{item}}"
    >{{item}}</view>
  </view>

  <view class="input-row">
    <input
      class="input"
      value="{{draft}}"
      placeholder="问教练点什么…"
      confirm-type="send"
      confirm-hold="{{true}}"
      bindinput="onInput"
      bindconfirm="send"
      disabled="{{thinking}}"
    />
    <button class="btn btn-primary send-btn" size="mini" bindtap="send" disabled="{{thinking || !draft}}">
      {{thinking ? '思考中' : '发送'}}
    </button>
  </view>
</view>
