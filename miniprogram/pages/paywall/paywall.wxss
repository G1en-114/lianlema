.page {
  padding-top: 24rpx;
}

.hero {
  text-align: center;
  padding: 48rpx 32rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.benefit-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  font-size: 30rpx;
}

.check {
  color: var(--brand);
  font-weight: 700;
  margin-right: 16rpx;
}

.demo-note {
  background: #fef3c7;
  color: var(--warn);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  text-align: center;
}

.fine-print {
  font-size: 22rpx;
  text-align: center;
  margin-top: 16rpx;
}

/* ---- AI 模型服务套餐 ---- */
.credit-pill {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 28rpx;
  background: var(--brand-weak);
  color: var(--brand);
  border-radius: 999rpx;
  font-size: 26rpx;
}

.tier-card {
  padding: 28rpx 32rpx;
}

.tier-current {
  border: 2rpx solid var(--brand);
}

.tier-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tier-name {
  font-size: 34rpx;
  font-weight: 700;
}

.tier-price .price-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand);
}

.tier-quota {
  margin: 8rpx 0 12rpx;
  font-size: 24rpx;
}
