<view class="page safe-bottom">
  <view class="card hero">
    <view class="hero-title">AI 模型服务</view>
    <view class="muted">端侧姿态识别永久免费；云端大模型能力按需订阅</view>
    <view class="credit-pill">云端额度余额：{{creditsText}}</view>
  </view>

  <view
    wx:for="{{tiers}}"
    wx:key="id"
    class="card tier-card {{currentTier === item.id ? 'tier-current' : ''}}"
  >
    <view class="tier-head">
      <view class="tier-name">{{item.name}}</view>
      <view class="tier-price">
        <text class="price-num">{{item.price}}</text>
        <text class="muted">/{{item.period}}</text>
      </view>
    </view>
    <view class="muted tier-quota">{{item.quota}}</view>
    <view wx:for="{{item.features}}" wx:for-item="f" wx:key="*this" class="benefit-row">
      <text class="check">✓</text>
      <text>{{f}}</text>
    </view>
    <button
      wx:if="{{item.id === 'free'}}"
      class="btn btn-plain"
      disabled
    >当前基础版</button>
    <button
      wx:elif="{{item.id === 'pro'}}"
      class="btn btn-primary"
      bindtap="purchasePro"
    >{{currentTier === 'pro' ? '已订阅（续费演示）' : '订阅 Pro（演示解锁）'}}</button>
    <button
      wx:else
      class="btn btn-primary"
      bindtap="purchaseBooster"
    >购买加油包（模拟 +10 次）</button>
  </view>

  <view class="card">
    <view class="demo-note">{{paidLabel}}</view>
    <button class="btn btn-plain" bindtap="restore">恢复购买</button>
    <view class="muted fine-print">正式版接入微信支付后，此处将展示真实价格与支付流程；云端额度与订阅状态将绑定微信账号。</view>
  </view>
</view>
