/* 设计令牌：主色 #F43F5E 珊瑚红（天猫定制款；回切微信版改回 #16A34A + #e8f7ee）*/
page {
  --brand: #f43f5e;
  --brand-weak: #ffe9ee;
  --danger: #dc2626;
  --warn: #d97706;
  --ink: #1f2937;
  --ink-2: #6b7280;
  --ink-3: #9ca3af;
  --line: #e5e7eb;
  --bg: #f5f7f6;
  --card: #ffffff;
  background: var(--bg);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.muted {
  color: var(--ink-2);
  font-size: 26rpx;
}

/* 按钮：主/次/危险，可点区域 ≥88rpx */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 24rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.btn-primary[disabled] {
  background: #a7d7bb;
  color: #fff;
}

.btn-plain {
  background: var(--brand-weak);
  color: var(--brand);
}

.btn-danger-plain {
  background: #fef2f2;
  color: var(--danger);
}

/* 选项 chip（问卷/控制按钮通用） */
.chip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
  font-size: 28rpx;
  box-sizing: border-box;
}

.chip-active {
  border-color: var(--brand);
  background: var(--brand-weak);
  color: var(--brand);
  font-weight: 600;
}

.chip-disabled {
  opacity: 0.4;
}

/* 徽标 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--brand-weak);
  color: var(--brand);
}

.badge-warn {
  background: #fef3c7;
  color: var(--warn);
}

.badge-danger {
  background: #fef2f2;
  color: var(--danger);
}

/* 安全区 */
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 空态 */
.empty {
  text-align: center;
  color: var(--ink-3);
  padding: 120rpx 48rpx;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: 16rpx;
}
